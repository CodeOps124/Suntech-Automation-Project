# ---------------------------------------------------------------------------
# Suntech Business Solutions — Form 145/146 Automation Platform
# Copy to `.env` and adjust. Never commit the real .env.
# ---------------------------------------------------------------------------

# App
APP_NAME="Suntech Form 145/146 Platform"
APP_ENV=dev                          # dev | staging | prod
DEBUG=true
SECRET_KEY=change-me-in-prod-use-a-64-char-random-string
API_V1_PREFIX=/api/v1

# Database (matches docker-compose service `db`)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=suntech
POSTGRES_PASSWORD=suntech_dev_pw
POSTGRES_DB=suntech_form145
# Full URL is derived from the parts above in app/core/config.py, but you can
# override it directly if you point at Supabase or a managed Postgres:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname
#
# Two-role security model (the compose stack sets both automatically):
#   DATABASE_URL            -> restricted `app_user` role; RLS ENFORCED. The
#                              normal app path. Role is created by migration
#                              0003 (change its dev password in prod!).
#   PRIVILEGED_DATABASE_URL -> owner/BYPASSRLS role; migrations, seeds, admin
#                              bootstrap, cross-tenant scheduler scans only.
# If you run the API bare (no Docker) against the compose DB, set:
# DATABASE_URL=postgresql+psycopg://app_user:app_user_dev_pw@localhost:5432/suntech_form145
# PRIVILEGED_DATABASE_URL=postgresql+psycopg://suntech:suntech_dev_pw@localhost:5432/suntech_form145

# Redis / Celery (matches docker-compose service `redis`)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Object storage — S3-compatible (dev: MinIO). Written against the S3 protocol,
# NOT tied to AWS. Point these at any S3-compatible bucket in prod.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=suntech-documents
S3_REGION=us-east-1
S3_USE_SSL=false

# OCR / document-AI (pluggable — external API, not built in-house).
# Leave OCR_PROVIDER=stub to run the deterministic offline stub in dev.
OCR_PROVIDER=stub                    # stub | external
OCR_API_URL=
OCR_API_KEY=

# Reminder scheduler cadence (document-gap chasing)
REMINDER_INTERVAL_HOURS=24
REMINDER_MAX_INCLUDED=3              # included reminders before it becomes billable rework

# Tax rules
ACTIVE_RULE_VERSION=2024.1          # which classification rule set is live

# Pipeline orchestration driver: celery (default) | n8n
# With n8n, uploads fire the webhook below and n8n drives the case through the
# /internal endpoints; on webhook failure the app falls back to Celery.
PIPELINE_DRIVER=celery
N8N_WEBHOOK_URL=http://host.docker.internal:5678/webhook/suncomply-intake
INTERNAL_API_TOKEN=change-me-internal-token
